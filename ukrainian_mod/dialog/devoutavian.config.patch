  {
    "op": "replace",
    "path": "/converse/avian/novakid/5",
    "value": "Звіздарі повинні почути про тебе!"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/6",
    "value": "Ти такий прекрасний!"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/7",
    "value": "Воїн, викуваний зі світла, посланий Клуексом!"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/8",
    "value": "Ти ж Новакіда, чи не так?"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/9",
    "value": "З таким сяйвом ти, мабуть, народжений небесами!"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/10",
    "value": "Сяюча людина, послана Клуексом!"
  },
  {
    "op": "replace",
    "path": "/converse/avian/novakid/11",
    "value": "Поглянь на своє небесне сяйво!"
