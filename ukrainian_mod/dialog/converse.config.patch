  {
    "op": "replace",
    "path": "/converse/floran/novakid/17",
    "value": "Ссстворення зі сссвітла ускладнює підкраданняссс!"
  },
  {
    "op": "replace",
    "path": "/converse/floran/novakid/18",
    "value": "Як ти підкрадаєшссся, коли ти сссвітло?"
  },
  {
    "op": "replace",
    "path": "/converse/floran/novakid/19",
    "value": "Ти не пахнеш як Флоранссс..."
  },
  {
    "op": "replace",
    "path": "/converse/floran/novakid/20",
    "value": "Не підходь надто близько до Флорана! Сссвітло лякаєссс."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/0",
    "value": "*Похмурість.* Не можу знайти свої улюблені черевики."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/1",
    "value": "*Спокій.* Поки що це був гарний день."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/2",
    "value": "*Веселощі.* Ти маєш кумедний вигляд!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/3",
    "value": "*Щастя.* Я сьогодні спіймав вісім жуків!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/4",
    "value": "*Радість.* Сьогодні мій день народження!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/5",
    "value": "*Ностальгія.* Тобі подобається це село? За моє життя воно майже не змінилося."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/6",
    "value": "*Меланхолія.* Чи життя за межами цього села таке ж самотнє, як тут?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/7",
    "value": "*Обережність.* Не знаю чому, але я завжди чекаю неприємностей."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/8",
    "value": "*Буркотливість.* Усі сьогодні такі галасливі..."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/9",
    "value": "*Страх.* Намагайся не створювати проблем."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/10",
    "value": "*Оптимізм.* Це буде гарний день."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/11",
    "value": "*Замисленість.* Іноді я цікавлюся, чи справді мої думки належать мені."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/12",
    "value": "*Вдумливість.* Не знаю чому, але мене тягне до зірок..."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/13",
    "value": "*Цікавість.* Розкажи мені про своє життя!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/14",
    "value": "*Нещастя.* Ніхто сьогодні не хоче купувати мої товари."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/15",
    "value": "*Оптимізм.* Гарного дня!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/16",
    "value": "*Втіха.* Життя може бути важким, але пам'ятай, що треба залишатися на позитиві."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/17",
    "value": "*Щастя.* Придивись, це гарне село."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/18",
    "value": "*Дружелюбність.* Почувайся як удома!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/19",
    "value": "*Боязкість.* О, п-привіт."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/20",
    "value": "*Щирість.* Тобі подобається мій капелюх?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/21",
    "value": "*Задоволення.* Це гарне село, чи не так?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/22",
    "value": "*Збентеженість.* Чому ти досліджуєш світ, коли міг би просто залишитися на одному місці і жити в комфорті?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/23",
    "value": "*Бадьорість.* Вітаю, друже!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/24",
    "value": "*Нетерпіння.* Цікаво, що я збудую сьогодні!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/25",
    "value": "*Незадоволення.* Мені треба змастити шарніри..."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/26",
    "value": "*Спостережливість.* Схоже, ти подорожував далеко."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/27",
    "value": "*Зацікавленість.* У тебе, мабуть, багато історій з твоїх подорожей."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/28",
    "value": "*Хитрість.* Гей, там! Шукаєш якісь, е-е, не зовсім легальні товари?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/29",
    "value": "*Підозрілість.* Ти ж не охоронець, чи не так?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/30",
    "value": "*Обережність.* Я не хочу створювати тут жодних проблем."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/31",
    "value": "*Настороженість.* У чому справа? У тебе зі мною проблеми?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/32",
    "value": "*Захист.* Не дивись на мене так, я не крав ці речі... Принаймні останнім часом."
