    "path": "/converse/glitch/hylotl/6",
    "value": "Я люблю свій дім."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/7",
    "value": "Він маленький, але зручний."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/8",
    "value": "Я побудував цей дім сам."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/9",
    "value": "Вогонь теплий."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/10",
    "value": "У мене є зручне ліжко для вас."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/11",
    "value": "Дякую за візит."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/12",
    "value": "*Цікавість.* Що це?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/13",
    "value": "*Зачарованість.* Це дивовижно!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/14",
    "value": "*Здивування.* Я не очікував знайти це тут."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/15",
    "value": "*Захоплення.* Нове відкриття!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/16",
    "value": "*Задумливість.* Я повинен вивчити це глибше."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/17",
    "value": "*Спантеличеність.* Я не розумію, як це працює."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/18",
    "value": "*Заінтригованість.* Це заслуговує на подальше розслідування."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/19",
    "value": "*Трепет.* Така неймовірна технологія."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/20",
    "value": "*Враженість.* Я ніколи не бачив нічого подібного."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/21",
    "value": "*Нетерпіння.* Давайте подивимось, що воно робить!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/22",
    "value": "*Обережність.* Ми повинні бути обережними з цим."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/23",
    "value": "*Нервозність.* Виглядає небезпечно."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/24",
    "value": "*Страх.* Мені не подобається, як це виглядає."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/25",
    "value": "*Нерішучість.* Можливо, нам не варто цього торкатися."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/26",
    "value": "*Уважність.* Будьте готові до всього."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/hylotl/27",
    "value": "*Спостережливість.* Зверніть увагу на складні деталі."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/0",
    "value": "*Аналітичність.* Я розрахую ймовірність успіху."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/1",
    "value": "*Логічність.* Це найбільш ефективне рішення."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/2",
    "value": "*Методичність.* Ми повинні діяти крок за кроком."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/3",
    "value": "*Задоволеність.* Експеримент пройшов успішно."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/4",
    "value": "*Розчарування.* Результати непереконливі."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/5",
    "value": "*Фрустрація.* Чому воно не працює?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/6",
    "value": "*Гнів.* Це марна трата часу!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/7",
    "value": "*Цілеспрямованість.* Я розв'яжу цю головоломку."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/8",
    "value": "*Рішучість.* Я не здамся."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/9",
    "value": "*Надія.* Можливо, цього разу спрацює."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/10",
    "value": "*Оптимізм.* У мене хороше передчуття щодо цього."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/11",
    "value": "*Песимізм.* Це приречено на провал."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/12",
    "value": "*Полегшення.* Це було близько!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/13",
    "value": "*Виснаженість.* Мені потрібно відпочити."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/14",
    "value": "*Гордість.* Я зробив це!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/15",
    "value": "*Хвалькуватість.* Бачите, чого я досяг?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/16",
    "value": "*Скромність.* Це були командні зусилля."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/17",
    "value": "*Вдячність.* Дякую за вашу допомогу."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/18",
    "value": "*Щирість.* Я ціную вашу допомогу."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/novakid/19",
    "value": "*Дружелюбність.* Ми - хороша команда!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/0",
    "value": "Ви всі не тутешні, га?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/1",
    "value": "Виглядаєш як мандрівник — ти десь із-за гори?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/2",
    "value": "Що скажеш про се місце? Файно тутки, нє?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/3",
    "value": "Шляк би трафив, здається-м забув де лишив своє банджо."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/4",
    "value": "Чуюся як молодий леґінь. А ти як?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/5",
    "value": "Як забув-єсь звідки прийшов, то лиш не забудь куди йдеш!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/6",
    "value": "Не пам'ятаю багато, крім того, що маю тримати розум при собі!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/7",
    "value": "Жи-м думав то буря суне, а то певно лиш ти!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/8",
    "value": "Є стара приказка — пий воду все вище по течії від стада муші."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/9",
    "value": "Най би його шляк трафив, забув-їм де лишив свою зубочистку."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/10",
    "value": "Вигляд маєш такий собі. Мав-єсь лихі часи, побратиме?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/11",
    "value": "Не важно звідки ти, важно куди ти прямуєш!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/12",
    "value": "Я все за файну забаву!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/13",
    "value": "Не хтів би ти слухати мої теревені цілий день. Йди живи, побратиме!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/14",
    "value": "Як біда стукає, мусиш навчитися замикати двері."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/15",
    "value": "Як виглядає, що воно не варте мозолів, то певно так і є."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/16",
    "value": "Мала порада для тебе — як хочеш вилізти з ями, перестань копати."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/generic/17",
    "value": "Файно бачиш. Як щодо стрілянини між тобою та мною, леґіню?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/default/0",
    "value": "Не видів-їм таких як ти. Хто ти в біса такий?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/0",
    "value": "То всі такі як ти, е-е, волохаті?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/1",
    "value": "Великий Мавп? То твій колєґа?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/2",
    "value": "Жи-м видів когось схожого на тебе, побратиме? Забув-їм."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/3",
    "value": "Мінікноґ? Не чув. То марка пива чи шо?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/4",
    "value": "Диктатори і повстанці? Виглядає, що ваші люди файно дістають по голові, га?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/5",
    "value": "Не стрічав-їм багато люду з таким лицем, але принаймні тебе не забуду!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/6",
    "value": "Файно би було мати бороду. Шляк би трафив, у мене навіть волосся не росте."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/apex/7",
    "value": "Твої люди певно мають бистрий розум — бачу по твоїх очах."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/0",
    "value": "Ти птах, га? Ну і дивовижа."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/1",
    "value": "Не видів-їм багато люду з таким пір'ям, скажу тобі!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/2",
    "value": "Твоє пір'я певно довго чистити!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/3",
    "value": "То ти з птахів, але не годний літати? Не пощастило тобі, побратиме."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/4",
    "value": "Певно тяжко бути птахом і не годен полетіти до зір..."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/5",
    "value": "Може ти не маєш крил, але завжди зможеш летіти на західнім вітрі у своїх снах, побратиме."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/avian/6",
    "value": "Ми сі виділи? Я би запам'ятав когось такого пір'ястого, але не впевнений..."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/0",
    "value": "Ви рослинний народ? Можете розмовляти з перекотиполем?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/1",
    "value": "Ти рослина, еге ж? Краще тобі не підходити надто близько до відкритого вогню!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/2",
    "value": "Рослини люблять сонця — я впевнений, що ми чудово порозуміємося."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/3",
    "value": "Ти продовжуй рости, а я продовжуватиму світитися, друже."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/4",
    "value": "У тебе добрячі зуби. Тільки не здумай спробувати мене з'їсти, коли я відвернуся, добре?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/5",
    "value": "Квітковий народ? Ну хіба ти не наймиліша річ, яку я бачив за довгий час!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/6",
    "value": "Я чув, дехто каже, що ви, рослинні види, дуже злісні, але мені ти здаєшся цілком нормальним!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/floran/7",
    "value": "У тебе і справді великі очі. Впевнений, що й серце в тебе велике!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/0",
    "value": "*Привітність.* Мені подобається працювати з вами."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/1",
    "value": "*Бадьорість.* Зробімо це!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/2",
    "value": "*Веселість.* Це весело!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/3",
    "value": "*Радість.* Ми перемогли!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/4",
    "value": "Ти ж металева машина, так? Це означає, що тебе хтось створив? ...Ти знаєш, хто саме?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/5",
    "value": "Ти зроблений з металу? Що ж, якщо тобі знадобиться хтось, щоб вирівняти вм'ятини, я до твоїх послуг!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/6",
    "value": "Мені подобається, як ти одягнений, мій металевий друже."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/glitch/7",
    "value": "Сподіваюся, ти не заіржавієш під час наступного дощу!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/0",
    "value": "Виглядаєш засмученим. Згубив щось цінне?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/1",
    "value": "Що ти за люд? Навіть не світишся... Не те щоб я щось мав проти, звісно."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/2",
    "value": "Всі ваші так вбираються?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/3",
    "value": "Може ти виглядаєш крихким, але якщо вмієш бистро стріляти, то ти гоноровий леґінь."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/4",
    "value": "Не світишся, га? Як ви в темряві видите?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/5",
    "value": "Маєш вигляд мандрівника, побратиме. Прямуєш до зір?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/6",
    "value": "Такого дивного леґеня я ще не видів."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/7",
    "value": "Виглядаєш так, ніби на тебе впала якась біда."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/8",
    "value": "Земний Захист? Не чув, вибачай побратиме."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/9",
    "value": "Ти далеко від хати, побратиме?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/human/10",
    "value": "Хоч як далеко мандруєш, не забувай часом вертатися до хати, побратиме."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/0",
    "value": "Троє очей, га? То, е-е, файно."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/1",
    "value": "Що ти видиш тим третім оком? То секрет?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/2",
    "value": "Виглядаєш натхненно. Ти якийсь маляр чи шо?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/3",
    "value": "Як бистро плаваєш? Б'юся об заклад, бистріше за мене."
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/4",
    "value": "Чув-їм, що ви мудрий люд. Годен обіграти мене в карти?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/5",
    "value": "Ходиш так гонорово. Тобі хтось таке казав?"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/6",
    "value": "Овва, та ти майже такий кольоровий як я!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/hylotl/7",
    "value": "Маєш бистре око. Певен, ніщо від тебе не сховається!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/novakid/0",
    "value": "Здоров, побратиме! Тримайся міцно і світи ясно!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/novakid/1",
    "value": "Світи ясно, побратиме!"
  },
  {
    "op": "replace",
    "path": "/converse/novakid/novakid/2",
