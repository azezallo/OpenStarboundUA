  {
    "op": "replace",
    "path": "/converse/glitch/generic/41",
    "value": "*Відчай.* Будь ласка, купи що-небудь!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/42",
    "value": "*Дружелюбність.* Потрібна допомога з посівами?"
