  {
    "op": "replace",
    "path": "/converse/glitch/generic/70",
    "value": "*Щастя.* Правління короля принесло нам мир."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/71",
    "value": "*Ностальгія.* Я пам'ятаю, коли короля коронували."
