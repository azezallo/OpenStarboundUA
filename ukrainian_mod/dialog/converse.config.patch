  {
    "op": "replace",
    "path": "/converse/glitch/generic/43",
    "value": "*Нетерпіння.* Не можу дочекатися, щоб побачити, що виросте наступним!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/44",
    "value": "*Щастя.* Я люблю доглядати за посівами."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/45",
    "value": "*Задоволення.* Ніщо не зрівняється з роботою на землі."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/46",
    "value": "*Втома.* Фермерство — це важка праця."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/47",
    "value": "*Гордість.* Поглянь на ці посіви!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/48",
    "value": "*Радість.* Мій урожай був багатим."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/49",
    "value": "*Оптимізм.* Із сонцем та водою ці посіви будуть процвітати."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/50",
    "value": "*Задумливість.* Ґрунт тут родючий."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/51",
    "value": "*Стурбованість.* Сподіваюся, скоро піде дощ."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/52",
    "value": "*Дружелюбність.* Бажаєте придбати свіжих продуктів?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/53",
    "value": "*Гостинність.* Бажаєте купити трохи насіння?"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/54",
    "value": "*Роздуми.* Цікаво, чи зможу я виростити щось екзотичне..."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/55",
    "value": "*Жалюгідність.* Шкідники знищують мої посіви!"
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/56",
    "value": "*Ностальгія.* Я фермерую тут уже цілі цикли."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/57",
    "value": "*Щирість.* Земля забезпечує нас усіх."
  },
  {
    "op": "replace",
    "path": "/converse/glitch/generic/58",
    "value": "*Вдячність.* Це честь служити нашому великому королю!"
