  },
  {
    "value": "Естер Брайт",
    "path": "/cultistmission07/senderName",
    "op": "replace"
  },
  {
    "value": "Ох, Азра, коли ж закінчиться твоя одержимість Руїною?",
    "path": "/cultistmission07/text",
