    "op": "replace"
  },
  {
    "value": "Лана Блейк",
    "path": "/cultistmission03a/senderName",
    "op": "replace"
  },
  {
    "value": "На щастя, літаюча фортеця нашого ворога має такі слабкі протоколи безпеки...",
    "path": "/cultistmission03a/text",
